{
  "name": "microsoft-todo-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Microsoft To Do (via Microsoft Graph).",
  "type": "module",
  "license": "MIT",
  "author": "Fabien Butz",
  "homepage": "https://github.com/fabienbutz/microsoft-todo-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabienbutz/microsoft-todo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fabienbutz/microsoft-todo-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microsoft-todo",
    "microsoft-graph",
    "todo",
    "tasks",
    "claude",
    "anthropic"
  ],
  "bin": {
    "microsoft-todo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/index.js",
    "dev": "pnpm build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "private": true
}
